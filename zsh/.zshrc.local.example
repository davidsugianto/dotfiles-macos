# ==============================================================================
# .zshrc.local.example — machine-specific overrides.
#
# Copy this file to ~/.zshrc.local (it is git-ignored) and put anything here
# that shouldn't live in the shared dotfiles repo: work-specific PATH
# entries, API tokens loaded from a secrets manager, per-machine aliases,
# etc. It is sourced last, so anything here wins.
# ==============================================================================

# export PATH="$HOME/work/bin:$PATH"
# export SOME_API_TOKEN="..."
# alias workvpn="sudo openconnect vpn.example.com"

# --- office LLM gateway (Cekat) ---------------------------------------------
# Read by the "cekat" provider in opencode/opencode.json, omp/models.yml,
# and pi/models.json (all repo-tracked).
# export CEKAT_API_KEY="sk-..."

# --- Slack MCP (omp + pi) ---------------------------------------------------
# Client ID/secret of your Slack app (api.slack.com/apps -> Basic Information).
# Read by the "slack" server in omp/mcp.json and pi/mcp-adapter.json via
# ${SLACK_MCP_CLIENT_ID} / ${SLACK_MCP_CLIENT_SECRET}. See README "Slack MCP".
# export SLACK_MCP_CLIENT_ID="1234567890.1234567890"
# export SLACK_MCP_CLIENT_SECRET="..."   # or: $(security find-generic-password -s slack-mcp-client-secret -w)
