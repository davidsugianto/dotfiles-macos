# Machine-specific shell overrides (see zsh/.zshrc.local.example)
.zshrc.local

# macOS
.DS_Store

# Editor/tool caches that shouldn't be committed if ever created here
*.swp
.direnv/

# Claude Code session state (not part of the dotfiles themselves)
.claude/

# omp creates this lock file next to config.yml/models.yml at runtime
# (it resolves the symlink and writes beside the real file) — not config
omp/*.lock

# pi likely does the same beside its symlinked settings.json/models.json —
# not confirmed, ignored preemptively so a lock file never lands in-repo.
pi/*.lock
pi/extensions/*/node_modules/

# Claude Code writes settings.json through the ~/.claude symlink; guard
# against temp/backup/lock files landing beside the real file in-repo.
claude/*.lock
claude/*.tmp*
claude/*.bak*

# pi-profile writes the currently active profile name here at runtime
# (machine state, changes on every /profile switch) — not config
pi/profiles/.active

# rtk records pi/omp ownership of the shared extension here if `rtk init --agent pi|omp`
# is ever run; machine state, not config
rtk/.rtk-agents
