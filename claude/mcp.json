{
  "mcpServers": {
    "datadog": {
      "type": "http",
      "url": "https://mcp.us5.datadoghq.com/v1/mcp?toolsets=all"
    },
    "jira": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "${SLACK_MCP_CLIENT_ID}",
        "callbackPort": 3118
      },
      "_clientSecretEnv": "SLACK_MCP_CLIENT_SECRET"
    }
  }
}
