# ==============================================================================
# .gitconfig — machine-wide git config. Identity/SSH key selection is split
# out per-directory below via includeIf, so this file stays identity-free
# and safe to keep in a shared dotfiles repo.
#
# Symlinked to ~/.gitconfig by setup.sh.
# ==============================================================================

#[core]
#    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[url "git@github.com:"]
    insteadOf = https://github.com/

# Repos under ~/Artifacts/labs/ use the personal identity/key.
[includeIf "gitdir:~/Artifacts/labs/"]
    path = ~/.gitconfig-personal

# Repos under ~/Artifacts/work/ use the work identity/key.
[includeIf "gitdir:~/Artifacts/work/"]
    path = ~/.gitconfig-work

[safe]
    directory = *
