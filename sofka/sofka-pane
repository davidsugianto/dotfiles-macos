#!/usr/bin/env bash
# Open a WezTerm pane whose kubectl/helm helpers target Sofka's active context.
set -euo pipefail

context=$1
namespace=$2
# A long-lived tmux server can preserve the socket path of a WezTerm GUI
# that has since quit. Probe without starting a mux server; if stale, let the
# CLI discover the currently running GUI instead.
if [[ -n ${WEZTERM_UNIX_SOCKET:-} ]] &&
  ! wezterm cli --no-auto-start list >/dev/null 2>&1; then
  unset WEZTERM_UNIX_SOCKET
fi

exec wezterm cli split-pane \
  --bottom \
  --percent 30 \
  -- \
  env "SOFKA_CONTEXT=$context" "SOFKA_NAMESPACE=$namespace" \
  zsh -ic 'printf "Sofka context: %s  namespace: %s\n" "$SOFKA_CONTEXT" "$SOFKA_NAMESPACE"; printf "k … runs kubectl against this context/namespace; helm … does the same.\n"; exec zsh -i'
