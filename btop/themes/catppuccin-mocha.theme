# Catppuccin Mocha for btop — https://github.com/catppuccin/catppuccin
# main_bg is left empty so the terminal shows through (see btop.conf's
# theme_background = false) — matches WezTerm's translucent window.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#cba6f7"

# Background color of selected item in processes box
theme[selected_bg]="#585b70"

# Foreground color of selected item in processes box
theme[selected_fg]="#cdd6f4"

# Color of inactive/disabled text
theme[inactive_fg]="#45475a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#cdd6f4"

# Background color of the percentage meters
theme[meter_bg]="#313244"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#94e2d5"

# Cpu box outline color
theme[cpu_box]="#cba6f7"

# Memory/disks box outline color
theme[mem_box]="#a6e3a1"

# Net up/down box outline color
theme[net_box]="#f38ba8"

# Processes box outline color
theme[proc_box]="#89b4fa"

# Box divider line and small boxes line color
theme[div_line]="#45475a"

# Temperature graph colors
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph colors
theme[cpu_start]="#89dceb"
theme[cpu_mid]="#89b4fa"
theme[cpu_end]="#cba6f7"

# Mem/Disk free meter
theme[free_start]="#a6e3a1"
theme[free_mid]="#94e2d5"
theme[free_end]="#89dceb"

# Mem/Disk cached meter
theme[cached_start]="#89dceb"
theme[cached_mid]="#74c7ec"
theme[cached_end]="#89b4fa"

# Mem/Disk available meter
theme[available_start]="#f9e2af"
theme[available_mid]="#fab387"
theme[available_end]="#f38ba8"

# Mem/Disk used meter
theme[used_start]="#a6e3a1"
theme[used_mid]="#94e2d5"
theme[used_end]="#89dceb"

# Download graph colors
theme[download_start]="#89b4fa"
theme[download_mid]="#94e2d5"
theme[download_end]="#a6e3a1"

# Upload graph colors
theme[upload_start]="#f38ba8"
theme[upload_mid]="#fab387"
theme[upload_end]="#f9e2af"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#a6e3a1"
theme[process_mid]="#94e2d5"
theme[process_end]="#89b4fa"
